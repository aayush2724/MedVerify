# Server Configuration
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
FLASK_ENV=development
PORT=5000

# Database — PostgreSQL is the primary database.
# Module 2 (medication safety) has materially higher read/write volume than the
# certificate module, and relies on JSONB for cached drug data.
DATABASE_URL=postgresql://medverify:change_me@localhost:5432/medverify
POSTGRES_PASSWORD=change_me
# SQLite remains supported for a quick local run:
# DATABASE_URL=sqlite:///./medverify_dev.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
JWT_BLOCKLIST_REDIS_URL=redis://localhost:6379/0
JWT_BLOCKLIST_REQUIRED=false

# Optional development seed users
# MEDVERIFY_SEED_ADMIN_PASSWORD=
# MEDVERIFY_SEED_VERIFIER_PASSWORD=
# MEDVERIFY_SEED_VIEWER_PASSWORD=

# ML Model (Module 1 only — Module 2 uses a rule engine, never a model)
# MODEL_PATH=./ml/models/classifier.pkl

# Module 2 — Medication Safety data sources.
# Both are public and need no key. An openFDA key raises the rate limit only.
# OPENFDA_API_KEY=

# Frontend
VITE_API_URL=http://localhost:5000
