# Production environment for docker-compose.prod.yml.
#
#     cp .env.production.example .env
#     # fill in the secrets below, then:
#     docker compose -f docker-compose.prod.yml up -d --build
#
# The compose file fails fast if SECRET_KEY, JWT_SECRET_KEY or POSTGRES_PASSWORD
# are missing, rather than booting with a default nobody meant to ship.

# ---------------------------------------------------------------- secrets ---
# Generate each of these separately:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Postgres superuser password for the bundled database container. Changing this
# after the first boot does NOT change the password already stored in the
# volume — see DEPLOYMENT.md before rotating it.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------ serving ---
# Port the frontend (nginx) publishes on the host. Leave at 80 for plain HTTP.
# When running the `tls` profile, set this to something else (e.g. 8080) so
# Caddy can take port 80 for the ACME challenge.
HTTP_PORT=80

# Only needed with `--profile tls`.
# DOMAIN=medverify.example.com
# ACME_EMAIL=ops@example.com

# Same-origin by default: nginx serves the SPA and proxies /api, so the browser
# never makes a cross-origin request. Set this only if you split the frontend
# and API onto different hosts.
# CORS_ORIGINS=https://medverify.example.com

# ------------------------------------------------------------------ scaling ---
# Each gunicorn worker loads spaCy + scikit-learn + OpenCV (~300-400 MB).
# Budget roughly 0.5 GB per worker before raising this.
WEB_CONCURRENCY=3
WORKER_CONCURRENCY=2
LOG_LEVEL=info

# ---------------------------------------------------------------- optional ---
# Both drug data sources are public and need no key. An openFDA key only raises
# the rate limit (240/min instead of 40/min), which matters if many people run
# prescription checks at once.
# OPENFDA_API_KEY=

# Seed users. Leave unset in production unless you want these accounts created.
# MEDVERIFY_SEED_ADMIN_PASSWORD=
# MEDVERIFY_SEED_VERIFIER_PASSWORD=
# MEDVERIFY_SEED_VIEWER_PASSWORD=
